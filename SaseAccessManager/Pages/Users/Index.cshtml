@page
@model SaseAccessManager.Pages.Users.IndexModel

<link rel="stylesheet" href="~/css/users/index.css" asp-append-version="true">

@if (TempData["ToastMessage"] != null)
{
    <div id="toast" class="toast @(TempData["ToastType"])">
        @(TempData["ToastType"]?.ToString() == "success" ? "✓" : "✕")
        @TempData["ToastMessage"]
    </div>
}

@functions {
    string GroupName(string groupId) =>
        Model.AllGroups.FirstOrDefault(g => g.Id == groupId)?.Name ?? groupId;

    string RowClass(UserStatus s) => s switch
    {
        UserStatus.Active => "row-active",
        UserStatus.Error => "row-error",
        UserStatus.Removed => "row-removed",
        _ => ""
    };
    string BadgeClass(UserStatus s) => s switch
    {
        UserStatus.Active => "badge badge-active",
        UserStatus.Error => "badge badge-error",
        UserStatus.Removed => "badge badge-removed",
        _ => "badge"
    };
    string StatusLabel(UserStatus s) => s switch
    {
        UserStatus.Active => "Ativo",
        UserStatus.Error => "Erro",
        UserStatus.Removed => "Removido",
        _ => s.ToString()
    };
    string UserInitials(string name) => string.IsNullOrWhiteSpace(name) ? "?" :
        name.Split(' ').Take(2).Aggregate("", (a, w) => a + (w.Length > 0 ? w[0].ToString().ToUpper() : ""));
}

@{
    var activeCount = Model.Users.Count(u => u.ST_USUARIO == UserStatus.Active);
    var errorCount = Model.Users.Count(u => u.ST_USUARIO == UserStatus.Error);
    var removedCount = Model.Users.Count(u => u.ST_USUARIO == UserStatus.Removed);
}

<!-- TOP BAR -->
<div class="topbar">
    <div class="topbar-brand">
        <div class="brand-icon">🛡</div>
        <div>
            <div class="brand-title">Harmony SASE</div>
            <div class="brand-sub">Access Manager</div>
        </div>
    </div>

    <div class="topbar-right">
        <div class="session-pill">
            <div class="avatar">@UserInitials(User.Identity?.Name ?? "")</div>
            <strong>@User.Identity?.Name</strong>
        </div>
        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="logout-btn">Sair</button>
        </form>
    </div>
</div>

<!-- MAIN CONTENT -->
<div class="main">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <div class="page-title">Usuários Temporários</div>
            <div class="page-subtitle">Gestão de acessos remotos via Harmony SASE</div>
        </div>
        <div class="header-actions">
            <button class="btn btn-ghost" id="refreshBtn">
                ↻ &nbsp;Atualizar
            </button>
            <button class="btn btn-ghost" id="logsBtn">
                📋 &nbsp;Logs
            </button>
            <a href="/Users/Create" class="btn btn-primary">
                + &nbsp;Novo usuário
            </a>
        </div>
    </div>

    <!-- STATS -->
    <div class="stats-row">
        <div class="stat-card green">
            <div class="stat-label">Ativos</div>
            <div class="stat-value">@activeCount</div>
        </div>
        <div class="stat-card red">
            <div class="stat-label">Com erro</div>
            <div class="stat-value">@errorCount</div>
        </div>
        <div class="stat-card gray">
            <div class="stat-label">Removidos</div>
            <div class="stat-value">@removedCount</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert-error">
            ⚠ @Model.ErrorMessage
        </div>
    }

    <!-- TABLE -->
    <div class="table-wrap">
        <div class="table-toolbar">
            <span id="totalCount" class="table-toolbar-title">@Model.Users.Count usuário(s)</span>
            <div class="search-input-wrap">
                <span class="search-icon">⌕</span>
                <input id="searchInput"
                       class="search-input"
                       type="text"
                       placeholder="Pesquisar…" />
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Nome</th>
                    <th>Grupos</th>
                    <th class="th-sortable is-active" data-sort="criado" id="thCriado">
                        Criado em <span class="sort-arrow">↓</span>
                    </th>
                    <th class="th-sortable" data-sort="expira" id="thExpira">
                        Expira em <span class="sort-arrow">↓</span>
                    </th>
                    <th>Chamado</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <div class="empty-icon">👤</div>
                                <div class="empty-text">Nenhum usuário encontrado.</div>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var u in Model.Users)
                {
                    <tr class="@RowClass(u.ST_USUARIO)">
                        <td class="cell-email">@u.DS_EMAIL</td>
                        <td class="cell-name">@u.NM_USUARIO @u.NM_SOBRENOME</td>
                        <td>
                            <div class="groups-trigger">
                                <svg class="groups-icon" width="16" height="16" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                    <circle cx="9" cy="7" r="4" />
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                </svg>
                                <span class="groups-count">@((u.DS_GRUPO_ACESSO?.Count ?? 0) + 1)</span>

                                <div class="groups-tooltip">
                                    <div class="tooltip-title">Grupos de acesso</div>

                                    <div class="tooltip-group is-locked">
                                        <span class="tooltip-dot locked"></span>
                                        All Users
                                        <span class="tooltip-lock-tag">padrão</span>
                                    </div>

                                    @if (u.DS_GRUPO_ACESSO != null && u.DS_GRUPO_ACESSO.Any())
                                    {
                                        @foreach (var gId in u.DS_GRUPO_ACESSO)
                                        {
                                            <div class="tooltip-group">
                                                <span class="tooltip-dot"></span>
                                                @GroupName(gId)
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="cell-date" data-timestamp="@((long)(u.DH_CRIACAO - DateTime.UnixEpoch).TotalSeconds)">
                            @u.DH_CRIACAO.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td data-expire="@((long)(u.DH_EXPIRACAO - DateTime.UnixEpoch).TotalSeconds)">
                            @if (u.ST_USUARIO == UserStatus.Removed)
                            {
                                <span class="expire-na">—</span>
                            }
                            else
                            {
                                var remaining = u.DH_EXPIRACAO - DateTime.UtcNow;
                                if (remaining.TotalSeconds <= 0)
                                {
                                    <span class="expire-expired">Expirado</span>
                                }
                                else if (remaining.TotalDays < 1)
                                {
                                    <span class="expire-today">⚡ Hoje</span>
                                }
                                else
                                {
                                    <span class="expire-ok">@Math.Ceiling(remaining.TotalDays) dias</span>
                                }
                            }
                        </td>
                        <td class="cell-chamado">
                            @if (!string.IsNullOrWhiteSpace(u.DS_CHAMADO))
                            {
                                if (u.DS_CHAMADO.Length > 30)
                                {
                                    <span class="chamado-truncated"
                                          title="Clique para ver completo"
                                          data-chamado="@u.DS_CHAMADO"
                                          data-email="@u.DS_EMAIL">
                                        @u.DS_CHAMADO[..30]…
                                    </span>
                                }
                                else
                                {
                                    <span>@u.DS_CHAMADO</span>
                                }
                            }
                            else
                            {
                                <span class="expire-na">—</span>
                            }
                        </td>
                        <td>
                            <span class="@BadgeClass(u.ST_USUARIO)">@StatusLabel(u.ST_USUARIO)</span>
                            @if (!string.IsNullOrWhiteSpace(u.DS_MOTIVO_REMOCAO))
                            {
                                var isAuto = u.DS_MOTIVO_REMOCAO.Contains("automaticamente", StringComparison.OrdinalIgnoreCase);
                                <span class="motivo-icon" title="@u.DS_MOTIVO_REMOCAO">@(isAuto ? "⏱" : "🗑")</span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                @if (u.ST_USUARIO != UserStatus.Removed)
                                {
                                    <form method="post" asp-page-handler="Remove" class="d-inline">
                                        <input type="hidden" name="id" value="@u.ID_USUARIO_SASE" />
                                        <button type="submit" class="btn btn-danger remove-btn" data-email="@u.DS_EMAIL">
                                            Remover
                                        </button>
                                    </form>
                                    <a asp-page="/Users/Create" asp-route-id="@u.ID_USUARIO_SASE" class="btn btn-edit">
                                        Editar
                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-reactivate reactivate-btn"
                                            data-email="@u.DS_EMAIL"
                                            data-id="@u.ID_USUARIO_SASE">
                                        Reativar
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- REACTIVATE MODAL -->
    <div id="reactivateModal" class="modal-overlay hidden">
        <div class="modal-box">
            <div class="modal-icon">♻️</div>
            <div class="modal-title">Reativar usuário</div>
            <div class="modal-body">
                Reativando acesso de <strong id="reactivateEmail"></strong>
                O usuário será recriado no SASE e voltará a ter acesso aos grupos anteriores.

                <div class="modal-duration">
                    <div class="modal-groups-label">Duração do acesso</div>
                    <div class="duration-presets" id="reactivatePresets">
                        <button type="button" class="preset-btn" data-days="30">30 dias</button>
                        <button type="button" class="preset-btn" data-days="90">90 dias</button>
                        <button type="button" class="preset-btn" data-days="180">180 dias</button>
                        <button type="button" class="preset-btn" data-days="365">365 dias</button>
                    </div>
                    <div class="number-input-wrap">
                        <div class="number-input">
                            <button type="button" class="num-btn minus" id="reactivateMinus">−</button>
                            <input type="number"
                                   id="reactivateDays"
                                   class="form-input"
                                   min="1"
                                   max="365"
                                   value="30" />
                            <button type="button" class="num-btn plus" id="reactivatePlus">+</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" id="cancelReactivateBtn" class="btn btn-ghost">Cancelar</button>
                <button type="button" id="confirmReactivateBtn" class="btn btn-primary">Reativar</button>
            </div>
        </div>
    </div>

    <!-- Form oculto para reativação -->
    <form id="reactivateForm" method="post" asp-page-handler="Reactivate" class="d-none">
        <input type="hidden" id="reactivateId" name="id" />
        <input type="hidden" id="reactivateDaysField" name="durationDays" value="30" />
    </form>

    <!-- CHAMADO MODAL -->
    <div id="chamadoModal" class="modal-overlay hidden">
        <div class="modal-box">
            <div class="modal-title">Chamado</div>
            <div class="modal-body">
                <div class="modal-groups-label" id="chamadoModalEmail"></div>
                <div id="chamadoModalText" class="chamado-modal-text"></div>
            </div>
            <div class="modal-actions">
                <button type="button" id="closeChamadoModal" class="btn btn-ghost">Fechar</button>
            </div>
        </div>
    </div>

    <!-- LOGS MODAL -->
    <div id="logsModal" class="modal-overlay hidden">
        <div class="modal-box modal-box--wide">
            <div class="modal-title">
                Logs da aplicação
                <button type="button" id="refreshLogsBtn" class="btn btn-ghost btn-refresh-logs">
                    ↻ Atualizar
                </button>
            </div>
            <div class="modal-body">
                <div id="logsFilter" class="logs-filter">
                    <input id="logsSearch" class="search-input width-full" type="text" placeholder="Filtrar logs..." />
                </div>
                <div id="logsContainer" class="logs-container">
                    <div class="loading-text">Carregando...</div>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" id="closeLogsBtn" class="btn btn-ghost">Fechar</button>
            </div>
        </div>
    </div>
</div>

<footer class="footer">
    <span>Desenvolvido pela CGSIC — Coordenação-Geral de Segurança da Informação e Cibersegurança</span>
</footer>

<div id="loadingOverlay" class="loading-overlay hidden">
    <div class="loader"></div>
    <div class="loading-text">Processando...</div>
</div>

<script nonce="@HttpContext.Items["CSP-Nonce"]">

        // ── Chamado modal ────────────────────────────────────────────────
    document.querySelectorAll('.chamado-truncated').forEach(el => {
        el.addEventListener('click', () => {
            document.getElementById('chamadoModalEmail').textContent = el.dataset.email;
            document.getElementById('chamadoModalText').textContent = el.dataset.chamado;
            document.getElementById('chamadoModal').classList.remove('hidden');
        });
    });

    document.getElementById('closeChamadoModal').addEventListener('click', () => {
        document.getElementById('chamadoModal').classList.add('hidden');
    });

    // ── Utilitários ───────────────────────────────────────────────────
    function showLoading(text = "Processando...") {
        const overlay = document.getElementById("loadingOverlay");
        overlay.querySelector(".loading-text").innerText = text;
        overlay.classList.remove("hidden");
    }

    function hideLoading() {
        document.getElementById("loadingOverlay").classList.add("hidden");
    }

    // ── Remove ────────────────────────────────────────────────────────
    document.querySelectorAll(".remove-btn").forEach(btn => {
        btn.addEventListener("click", function (e) {
            const email = this.dataset.email;
            if (!confirm(`Remover acesso de ${email}?`)) {
                e.preventDefault();
            }
        });
    });

    // ── Refresh ───────────────────────────────────────────────────────
    document.getElementById("refreshBtn")?.addEventListener("click", function () {
        this.innerText = "↻  Atualizando…";
        location.reload();
    });

    // ── Toast ─────────────────────────────────────────────────────────
    setTimeout(() => {
        const t = document.getElementById("toast");
        if (t) { t.classList.add("toast-fade-out"); setTimeout(() => t.remove(), 400); }
    }, 5000);

    // ── Loading em submits ────────────────────────────────────────────
    document.querySelectorAll("form").forEach(form => {
        form.addEventListener("submit", () => {
            showLoading("Processando...");
            document.body.classList.add("cursor-wait");
        });
    });

    // ── Search ────────────────────────────────────────────────────────
    const searchInput = document.getElementById('searchInput');
    const rows        = document.querySelectorAll('tbody tr');
    const totalCount  = document.getElementById('totalCount');

    function updateCount(visible) {
        const total = rows.length;
        totalCount.textContent = visible < total
            ? `${visible} de ${total} usuário(s)`
            : `${total} usuário(s)`;
    }

    updateCount(rows.length);

    searchInput.addEventListener('input', () => {
        const term = searchInput.value.toLowerCase().trim();
        let visible = 0;
        rows.forEach(row => {
            const match = !term || row.textContent.toLowerCase().includes(term);
            row.classList.toggle('row-hidden', !match);
            if (match) visible++;
        });
        updateCount(visible);
    });

    // ── Reactivate modal ──────────────────────────────────────────────
    const reactivateModal     = document.getElementById('reactivateModal');
    const reactivateEmailEl   = document.getElementById('reactivateEmail');
    const reactivateIdField   = document.getElementById('reactivateId');
    const reactivateDays      = document.getElementById('reactivateDays');
    const reactivateDaysField = document.getElementById('reactivateDaysField');
    const reactivatePresets   = document.querySelectorAll('#reactivatePresets .preset-btn');

    function syncReactivatePresets() {
        reactivatePresets.forEach(b =>
            b.classList.toggle('is-active', b.dataset.days === reactivateDays.value));
    }

    reactivatePresets.forEach(btn => {
        btn.addEventListener('click', () => {
            reactivateDays.value = btn.dataset.days;
            syncReactivatePresets();
        });
    });

    reactivateDays.addEventListener('input', () => {
        reactivatePresets.forEach(b => b.classList.remove('is-active'));
    });

    document.getElementById('reactivateMinus').addEventListener('click', () => {
        if (parseInt(reactivateDays.value) > 1) reactivateDays.stepDown();
        syncReactivatePresets();
    });

    document.getElementById('reactivatePlus').addEventListener('click', () => {
        if (parseInt(reactivateDays.value) < 365) reactivateDays.stepUp();
        syncReactivatePresets();
    });

    document.querySelectorAll('.reactivate-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            reactivateEmailEl.textContent = btn.dataset.email;
            reactivateIdField.value       = btn.dataset.id;
            reactivateDays.value          = '30';
            syncReactivatePresets();
            reactivateModal.classList.remove('hidden');
        });
    });

    document.getElementById('cancelReactivateBtn').addEventListener('click', () => {
        reactivateModal.classList.add('hidden');
    });

    document.getElementById('confirmReactivateBtn').addEventListener('click', () => {
        reactivateDaysField.value = reactivateDays.value;
        showLoading("Reativando usuário...");
        document.getElementById('reactivateForm').submit();
    });

        // ── Logs modal ───────────────────────────────────────────────────
    const logsModal     = document.getElementById('logsModal');
    const logsContainer = document.getElementById('logsContainer');
    const logsSearch    = document.getElementById('logsSearch');
    let allLogs = [];

    function levelClass(level) {
        switch (level) {
            case 'Warning':  return 'log-warn';
            case 'Error':    return 'log-error';
            case 'Critical': return 'log-error';
            default:         return 'log-info';
        }
    }

    function renderLogs(filter = '') {
        const term = filter.toLowerCase();
        const filtered = term
            ? allLogs.filter(l => l.message.toLowerCase().includes(term)
                               || l.category.toLowerCase().includes(term)
                               || l.level.toLowerCase().includes(term))
            : allLogs;

        while (logsContainer.firstChild)
            logsContainer.removeChild(logsContainer.firstChild);

        if (filtered.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'empty-text';
            empty.textContent = 'Nenhum log encontrado.';
            logsContainer.appendChild(empty);
            return;
        }

        filtered.forEach(l => {
            const line = document.createElement('div');
            line.className = 'log-line ' + levelClass(l.level);

            const time = document.createElement('span');
            time.className = 'log-time';
            time.textContent = l.time;

            const level = document.createElement('span');
            level.className = 'log-level';
            level.textContent = l.level;

            const cat = document.createElement('span');
            cat.className = 'log-cat';
            cat.textContent = l.category;

            const msg = document.createElement('span');
            msg.className = 'log-msg';
            msg.textContent = l.message;

            line.appendChild(time);
            line.appendChild(level);
            line.appendChild(cat);
            line.appendChild(msg);

            logsContainer.appendChild(line);
        });
    }

    async function loadLogs() {
        while (logsContainer.firstChild)
            logsContainer.removeChild(logsContainer.firstChild);
        const loading = document.createElement('div');
        loading.className = 'loading-text';
        loading.textContent = 'Carregando...';
        logsContainer.appendChild(loading);

        try {
            const res = await fetch('/api/logs');
            allLogs = await res.json();
            renderLogs(logsSearch.value);
        } catch {
            while (logsContainer.firstChild)
                logsContainer.removeChild(logsContainer.firstChild);
            const err = document.createElement('div');
            err.className = 'empty-text';
            err.textContent = 'Erro ao carregar logs.';
            logsContainer.appendChild(err);
        }
    }

    document.getElementById('logsBtn').addEventListener('click', () => {
        logsModal.classList.remove('hidden');
        loadLogs();
    });

    document.getElementById('closeLogsBtn').addEventListener('click', () => {
        logsModal.classList.add('hidden');
    });

    document.getElementById('refreshLogsBtn').addEventListener('click', loadLogs);

    logsSearch.addEventListener('input', () => renderLogs(logsSearch.value));

    // ── Sort ──────────────────────────────────────────────────────────
    const tbody = document.querySelector('tbody');
    const sortHeaders = document.querySelectorAll('.th-sortable');
    let currentSort = 'criado';
    let currentAsc = false;

    function sortTable(field, asc) {
        const rowsArray = Array.from(tbody.querySelectorAll('tr'));

        rowsArray.sort((a, b) => {
            const statusA = a.classList.contains('row-removed') ? 1 : 0;
            const statusB = b.classList.contains('row-removed') ? 1 : 0;
            if (statusA !== statusB) return statusA - statusB;

            let valA, valB;
            if (field === 'criado') {
                valA = parseInt(a.querySelector('.cell-date')?.dataset.timestamp || '0');
                valB = parseInt(b.querySelector('.cell-date')?.dataset.timestamp || '0');
            } else {
                valA = parseInt(a.querySelector('[data-expire]')?.dataset.expire || '0');
                valB = parseInt(b.querySelector('[data-expire]')?.dataset.expire || '0');
            }

            return asc ? valA - valB : valB - valA;
        });

        rowsArray.forEach(row => tbody.appendChild(row));
    }

    sortHeaders.forEach(th => {
        th.addEventListener('click', () => {
            const field = th.dataset.sort;

            if (currentSort === field) {
                currentAsc = !currentAsc;
            } else {
                currentSort = field;
                currentAsc = false;
            }

            sortHeaders.forEach(h => h.classList.remove('is-active', 'asc'));
            th.classList.add('is-active');
            if (currentAsc) th.classList.add('asc');

            sortTable(currentSort, currentAsc);
        });
    });

</script>
