@page
@model SaseAccessManager.Pages.Users.IndexModel

<link rel="stylesheet" href="~/css/users/index.css" asp-append-version="true">

@if (TempData["ToastMessage"] != null)
{
    <div id="toast" class="toast @(TempData["ToastType"])">
        @(TempData["ToastType"]?.ToString() == "success" ? "✓" : "✕")
        @TempData["ToastMessage"]
    </div>
}

@functions {
    string GroupName(string groupId) =>
        Model.AllGroups.FirstOrDefault(g => g.Id == groupId)?.Name ?? groupId;

    const int DiasAvisoExpiracao = 15;

    bool IsExpiring(TemporarySaseUser u)
    {
        if (u.ST_USUARIO != UserStatus.Active || u.IsAdmin)
            return false;

        var remaining = u.DH_EXPIRACAO - DateTime.UtcNow;
        return remaining.TotalSeconds > 0 && Math.Ceiling(remaining.TotalDays) <= DiasAvisoExpiracao;
    }

    string RowClass(UserStatus s) => s switch
    {
        UserStatus.Active => "row-active",
        UserStatus.Error => "row-error",
        UserStatus.Removed => "row-removed",
        _ => ""
    };
    string BadgeClass(UserStatus s) => s switch
    {
        UserStatus.Active => "badge badge-active",
        UserStatus.Error => "badge badge-error",
        UserStatus.Removed => "badge badge-removed",
        _ => "badge"
    };
    string StatusLabel(UserStatus s) => s switch
    {
        UserStatus.Active => "Ativo",
        UserStatus.Error => "Erro",
        UserStatus.Removed => "Removido",
        _ => s.ToString()
    };
    string UserInitials(string name) => string.IsNullOrWhiteSpace(name) ? "?" :
        name.Split(' ').Take(2).Aggregate("", (a, w) => a + (w.Length > 0 ? w[0].ToString().ToUpper() : ""));
}

@{
    var activeCount = Model.Users.Count(u => u.ST_USUARIO == UserStatus.Active);
    var errorCount = Model.Users.Count(u => u.ST_USUARIO == UserStatus.Error);
    var removedCount = Model.Users.Count(u => u.ST_USUARIO == UserStatus.Removed);
    var expiringCount = Model.Users.Count(IsExpiring);
}

<!-- TOP BAR -->
<div class="topbar">
    <div class="topbar-brand">
        <div class="brand-icon">🛡</div>
        <div>
            <div class="brand-title">Harmony SASE</div>
            <div class="brand-sub">Access Manager</div>
        </div>
    </div>

    <div class="topbar-right">
        <div class="session-pill">
            <div class="avatar">@UserInitials(User.Identity?.Name ?? "")</div>
            <strong>@User.Identity?.Name</strong>
        </div>
        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="logout-btn">Sair</button>
        </form>
    </div>
</div>

<!-- Ícone de grupos (definido uma vez, reaproveitado em todas as linhas) -->
<svg class="svg-sprite" width="0" height="0" aria-hidden="true" focusable="false">
    <symbol id="icon-groups" viewBox="0 0 24 24">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
    </symbol>
</svg>

<!-- Tooltip de grupos único, preenchido via JS -->
<div id="groupsTooltip" class="groups-tooltip-float" role="tooltip"></div>

<!-- MAIN CONTENT -->
<div class="main">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <div class="page-title">Usuários Temporários</div>
            <div class="page-subtitle">Gestão de acessos remotos via Harmony SASE</div>
        </div>
        <div class="header-actions">
            <button class="btn btn-ghost" id="refreshBtn">
                ↻ &nbsp;Atualizar
            </button>
            <button class="btn btn-ghost" id="logsBtn">
                📋 &nbsp;Logs
            </button>
            <a href="/Users/Create" class="btn btn-primary">
                + &nbsp;Novo usuário
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert-error">
            ⚠ @Model.ErrorMessage
        </div>
    }

    <!-- TABLE -->
    <div class="table-wrap">
        <div class="table-toolbar">
            <div class="toolbar-left">
                <span id="totalCount" class="table-toolbar-title">@Model.Users.Count usuário(s)</span>
                <div class="status-chips" role="group" aria-label="Filtrar por status">
                    <button type="button" class="status-chip is-active" data-filter="all">Todos <strong>@Model.Users.Count</strong></button>
                    <button type="button" class="status-chip chip-active" data-filter="row-active">Ativos <strong>@activeCount</strong></button>
                    <button type="button" class="status-chip chip-error" data-filter="row-error">Com erro <strong>@errorCount</strong></button>
                    <button type="button" class="status-chip chip-expiring" data-filter="row-expiring" title="Ativos com @DiasAvisoExpiracao dias ou menos para expirar">A expirar <strong>@expiringCount</strong></button>
                    <button type="button" class="status-chip chip-removed" data-filter="row-removed">Removidos <strong>@removedCount</strong></button>
                </div>
            </div>
            <div class="search-input-wrap">
                <span class="search-icon">⌕</span>
                <input id="searchInput"
                       class="search-input"
                       type="text"
                       placeholder="Pesquisar…" />
            </div>
        </div>

        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Nome</th>
                        <th>Grupos</th>
                        <th class="th-sortable is-active" data-sort="criado" id="thCriado">
                            Criado em <span class="sort-arrow">↓</span>
                        </th>
                        <th class="th-sortable" data-sort="expira" id="thExpira">
                            Expira em <span class="sort-arrow">↓</span>
                        </th>
                        <th>Chamado</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-icon">👤</div>
                                    <div class="empty-text">Nenhum usuário encontrado.</div>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var u in Model.Users)
                    {
                        <tr class="@RowClass(u.ST_USUARIO) @(IsExpiring(u) ? "row-expiring" : "")">
                            <td class="cell-email">@u.DS_EMAIL</td>
                            <td class="cell-name">@u.NM_USUARIO @u.NM_SOBRENOME</td>
                            <td>
                                <div class="groups-trigger" data-groups="@(string.Join("|", (u.DS_GRUPO_ACESSO ?? new List<string>()).Select(GroupName)))">
                                    <svg class="groups-icon" width="16" height="16" aria-hidden="true"><use href="#icon-groups"></use></svg>
                                    <span class="groups-count">@((u.DS_GRUPO_ACESSO?.Count ?? 0) + 1)</span>
                                </div>
                            </td>
                            <td class="cell-date" data-timestamp="@((long)(u.DH_CRIACAO - DateTime.UnixEpoch).TotalSeconds)">
                                @u.DH_CRIACAO.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td data-expire="@(u.IsAdmin ? 253402300799L : (long)(u.DH_EXPIRACAO - DateTime.UnixEpoch).TotalSeconds)">
                                @if (u.ST_USUARIO == UserStatus.Removed)
                                {
                                    <span class="expire-na">—</span>
                                }
                                else if (u.IsAdmin)
                                {
                                    <span class="expire-permanent" title="Usuários Admin não podem ser excluídos pela API do SASE e não expiram"><span class="lock-icon">🔒</span>Permanente</span>
                                }
                                else
                                {
                                    var remaining = u.DH_EXPIRACAO - DateTime.UtcNow;
                                    if (remaining.TotalSeconds <= 0)
                                    {
                                        <span class="expire-expired">Expirado</span>
                                    }
                                    else if (remaining.TotalDays < 1)
                                    {
                                        <span class="expire-today">⚡ Hoje</span>
                                    }
                                    else if (Math.Ceiling(remaining.TotalDays) <= DiasAvisoExpiracao)
                                    {
                                        <span class="expire-soon" title="Expira em até @DiasAvisoExpiracao dias">⏳ @Math.Ceiling(remaining.TotalDays) dias</span>
                                    }
                                    else
                                    {
                                        <span class="expire-ok">@Math.Ceiling(remaining.TotalDays) dias</span>
                                    }
                                }
                            </td>
                            <td class="cell-chamado">
                                @if (!string.IsNullOrWhiteSpace(u.DS_CHAMADO))
                                {
                                    if (u.DS_CHAMADO.Length > 30)
                                    {
                                        <span class="chamado-truncated"
                                              title="Clique para ver completo"
                                              data-chamado="@u.DS_CHAMADO"
                                              data-email="@u.DS_EMAIL">
                                            @u.DS_CHAMADO[..30]…
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@u.DS_CHAMADO</span>
                                    }
                                }
                                else
                                {
                                    <span class="expire-na">—</span>
                                }
                            </td>
                            <td>
                                <div class="status-cell">
                                    <span class="@BadgeClass(u.ST_USUARIO)">@StatusLabel(u.ST_USUARIO)</span>
                                    @if (u.IsAdmin)
                                    {
                                        <span class="badge badge-admin">Admin</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(u.DS_MOTIVO_REMOCAO))
                                    {
                                        var isAuto = u.DS_MOTIVO_REMOCAO.Contains("automaticamente", StringComparison.OrdinalIgnoreCase);
                                        var hasObs = !string.IsNullOrWhiteSpace(u.DS_OBSERVACAO_REMOCAO);
                                        var motivoTitle = hasObs
                                            ? $"{u.DS_MOTIVO_REMOCAO}\nObs: {u.DS_OBSERVACAO_REMOCAO}"
                                            : u.DS_MOTIVO_REMOCAO;
                                        <span class="motivo-icon @(hasObs ? "has-obs" : "")"
                                              title="@motivoTitle"
                                              data-email="@u.DS_EMAIL"
                                              data-motivo="@u.DS_MOTIVO_REMOCAO"
                                              data-obs="@u.DS_OBSERVACAO_REMOCAO">@(isAuto ? "⏱" : "🗑")@(hasObs ? "📝" : "")</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="actions">
                                    @if (u.ST_USUARIO != UserStatus.Removed)
                                    {
                                        if (!u.IsAdmin)
                                        {
                                            <button type="button"
                                                    class="btn btn-danger remove-btn"
                                                    data-email="@u.DS_EMAIL"
                                                    data-id="@u.ID_USUARIO_SASE">
                                                Remover
                                            </button>
                                        }
                                        <a asp-page="/Users/Create" asp-route-id="@u.ID_USUARIO_SASE" class="btn btn-edit">
                                            Editar
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-reactivate reactivate-btn"
                                                data-email="@u.DS_EMAIL"
                                                data-id="@u.ID_USUARIO_SASE"
                                                data-name="@u.NM_USUARIO"
                                                data-lastname="@u.NM_SOBRENOME">
                                            Reativar
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- REACTIVATE MODAL -->
    <div id="reactivateModal" class="modal-overlay hidden">
        <div class="modal-box">
            <div class="modal-icon">♻️</div>
            <div class="modal-title">Reativar usuário</div>
            <div class="modal-body">
                Reativando acesso de <strong id="reactivateEmail"></strong>
                O usuário será recriado no SASE e voltará a ter acesso aos grupos anteriores.

                <div class="modal-duration">
                    <div class="modal-groups-label reactivate-name-label">
                        Nome no SASE
                        <button type="button" id="reactivateStripAccents" class="btn btn-ghost btn-xs">Remover acentos</button>
                    </div>
                    <div class="reactivate-name-grid">
                        <input type="text" id="reactivateName" class="form-input" maxlength="100" placeholder="Nome" />
                        <input type="text" id="reactivateLastName" class="form-input" maxlength="100" placeholder="Sobrenome" />
                    </div>
                    <div id="reactivateNameError" class="reactivate-name-error hidden"></div>
                </div>

                <div class="modal-duration">
                    <div class="modal-groups-label">Duração do acesso</div>
                    <div class="duration-presets" id="reactivatePresets">
                        <button type="button" class="preset-btn" data-days="30">30 dias</button>
                        <button type="button" class="preset-btn" data-days="90">90 dias</button>
                        <button type="button" class="preset-btn" data-days="180">180 dias</button>
                        <button type="button" class="preset-btn" data-days="365">365 dias</button>
                    </div>
                    <div class="number-input-wrap">
                        <div class="number-input">
                            <button type="button" class="num-btn minus" id="reactivateMinus">−</button>
                            <input type="number"
                                   id="reactivateDays"
                                   class="form-input"
                                   min="1"
                                   max="365"
                                   value="30" />
                            <button type="button" class="num-btn plus" id="reactivatePlus">+</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" id="cancelReactivateBtn" class="btn btn-ghost">Cancelar</button>
                <button type="button" id="confirmReactivateBtn" class="btn btn-primary">Reativar</button>
            </div>
        </div>
    </div>

    <!-- Form oculto para reativação -->
    <form id="reactivateForm" method="post" asp-page-handler="Reactivate" class="d-none">
        <input type="hidden" id="reactivateId" name="id" />
        <input type="hidden" id="reactivateDaysField" name="durationDays" value="30" />
        <input type="hidden" id="reactivateNameField" name="name" />
        <input type="hidden" id="reactivateLastNameField" name="lastName" />
    </form>

    <!-- REMOVE MODAL -->
    <div id="removeModal" class="modal-overlay hidden">
        <div class="modal-box">
            <div class="modal-icon">🗑</div>
            <div class="modal-title">Remover usuário</div>
            <div class="modal-body">
                Remover acesso de <strong id="removeEmail"></strong>?<br>
                O usuário será excluído do Harmony SASE.

                <div class="modal-duration">
                    <div class="modal-groups-label">Observação (opcional)</div>
                    <textarea id="removeObs"
                              class="form-input"
                              rows="3"
                              maxlength="500"
                              placeholder="Ex: desligamento do colaborador, solicitação do chamado 55314123, acesso não mais necessário..."></textarea>
                    <div class="obs-counter"><span id="removeObsCount">0</span>/500</div>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" id="cancelRemoveBtn" class="btn btn-ghost">Cancelar</button>
                <button type="button" id="confirmRemoveBtn" class="btn btn-danger">Remover</button>
            </div>
        </div>
    </div>

    <!-- Form oculto para remoção -->
    <form id="removeForm" method="post" asp-page-handler="Remove" class="d-none">
        <input type="hidden" id="removeId" name="id" />
        <input type="hidden" id="removeObsField" name="observacao" />
    </form>

    <!-- CHAMADO MODAL -->
    <div id="chamadoModal" class="modal-overlay hidden">
        <div class="modal-box">
            <div class="modal-title" id="chamadoModalTitle">Chamado</div>
            <div class="modal-body">
                <div class="modal-groups-label" id="chamadoModalEmail"></div>
                <div id="chamadoModalText" class="chamado-modal-text"></div>
            </div>
            <div class="modal-actions">
                <button type="button" id="closeChamadoModal" class="btn btn-ghost">Fechar</button>
            </div>
        </div>
    </div>

    <!-- LOGS MODAL -->
    <div id="logsModal" class="modal-overlay hidden">
        <div class="modal-box modal-box--wide">
            <div class="modal-title">
                Logs da aplicação
                <button type="button" id="refreshLogsBtn" class="btn btn-ghost btn-refresh-logs">
                    ↻ Atualizar
                </button>
            </div>
            <div class="modal-body">
                <div id="logsFilter" class="logs-filter">
                    <input id="logsSearch" class="search-input width-full" type="text" placeholder="Filtrar logs..." />
                </div>
                <div id="logsContainer" class="logs-container">
                    <div class="loading-text">Carregando...</div>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" id="closeLogsBtn" class="btn btn-ghost">Fechar</button>
            </div>
        </div>
    </div>
</div>

<footer class="footer">
    <span>Desenvolvido pela CGSIC — Coordenação-Geral de Segurança da Informação e Cibersegurança</span>
</footer>

<div id="loadingOverlay" class="loading-overlay hidden">
    <div class="loader"></div>
    <div class="loading-text">Processando...</div>
</div>

<script nonce="@HttpContext.Items["CSP-Nonce"]">

    // ── Chamado modal ────────────────────────────────────────────────
    document.querySelectorAll('.chamado-truncated').forEach(el => {
        el.addEventListener('click', () => {
            document.getElementById('chamadoModalTitle').textContent = 'Chamado';
            document.getElementById('chamadoModalEmail').textContent = el.dataset.email;
            document.getElementById('chamadoModalText').textContent = el.dataset.chamado;
            document.getElementById('chamadoModal').classList.remove('hidden');
        });
    });

    document.getElementById('closeChamadoModal').addEventListener('click', () => {
        document.getElementById('chamadoModal').classList.add('hidden');
    });

    // ── Utilitários ───────────────────────────────────────────────────
    function showLoading(text = "Processando...") {
        const overlay = document.getElementById("loadingOverlay");
        overlay.querySelector(".loading-text").innerText = text;
        overlay.classList.remove("hidden");
    }

    function hideLoading() {
        document.getElementById("loadingOverlay").classList.add("hidden");
    }

    // ── Remove modal ──────────────────────────────────────────────────
    const removeModal = document.getElementById('removeModal');
    const removeEmailEl = document.getElementById('removeEmail');
    const removeIdField = document.getElementById('removeId');
    const removeObs = document.getElementById('removeObs');
    const removeObsField = document.getElementById('removeObsField');
    const removeObsCount = document.getElementById('removeObsCount');

    removeObs.addEventListener('input', () => {
        removeObsCount.textContent = removeObs.value.length;
    });

    document.querySelectorAll('.remove-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            removeEmailEl.textContent = btn.dataset.email;
            removeIdField.value = btn.dataset.id;
            removeObs.value = '';
            removeObsCount.textContent = '0';
            removeModal.classList.remove('hidden');
            removeObs.focus();
        });
    });

    document.getElementById('cancelRemoveBtn').addEventListener('click', () => {
        removeModal.classList.add('hidden');
    });

    document.getElementById('confirmRemoveBtn').addEventListener('click', () => {
        removeObsField.value = removeObs.value.trim();
        showLoading("Removendo usuário...");
        document.getElementById('removeForm').submit();
    });

    // ── Motivo/observação de remoção (clique abre modal) ──────────────
    document.querySelectorAll('.motivo-icon.has-obs').forEach(el => {
        el.addEventListener('click', () => {
            document.getElementById('chamadoModalTitle').textContent = 'Remoção';
            document.getElementById('chamadoModalEmail').textContent = el.dataset.email;
            document.getElementById('chamadoModalText').textContent =
                `${el.dataset.motivo}\n\nObservação:\n${el.dataset.obs}`;
            document.getElementById('chamadoModal').classList.remove('hidden');
        });
    });

    // ── Refresh ───────────────────────────────────────────────────────
    document.getElementById("refreshBtn")?.addEventListener("click", function () {
        this.innerText = "↻  Atualizando…";
        location.reload();
    });

    // ── Toast ─────────────────────────────────────────────────────────
    setTimeout(() => {
        const t = document.getElementById("toast");
        if (t) { t.classList.add("toast-fade-out"); setTimeout(() => t.remove(), 400); }
    }, 5000);

    // ── Loading em submits ────────────────────────────────────────────
    document.querySelectorAll("form").forEach(form => {
        form.addEventListener("submit", () => {
            showLoading("Processando...");
            document.body.classList.add("cursor-wait");
        });
    });

    // ── Search + filtro por status ────────────────────────────────────
    const searchInput = document.getElementById('searchInput');
    const rows = document.querySelectorAll('tbody tr');
    const totalCount = document.getElementById('totalCount');
    const statusChips = document.querySelectorAll('.status-chip');
    let statusFilter = 'all';

    function updateCount(visible) {
        const total = rows.length;
        totalCount.textContent = visible < total
            ? `${visible} de ${total} usuário(s)`
            : `${total} usuário(s)`;
    }

    // Texto de busca calculado uma vez por linha (inclui os nomes dos grupos)
    const searchText = new Map();
    rows.forEach(row => {
        const groups = row.querySelector('.groups-trigger')?.dataset.groups || '';
        searchText.set(row, (row.textContent + ' ' + groups.replaceAll('|', ' ')).toLowerCase());
    });

    function applyFilters() {
        const term = searchInput.value.toLowerCase().trim();
        let visible = 0;
        rows.forEach(row => {
            const matchText = !term || searchText.get(row).includes(term);
            const matchStatus = statusFilter === 'all' || row.classList.contains(statusFilter);
            const show = matchText && matchStatus;
            row.classList.toggle('row-hidden', !show);
            if (show) visible++;
        });
        updateCount(visible);
    }

    statusChips.forEach(chip => {
        chip.addEventListener('click', () => {
            statusFilter = chip.dataset.filter;
            statusChips.forEach(c => c.classList.toggle('is-active', c === chip));
            applyFilters();
        });
    });

    // Ao começar uma pesquisa, volta o filtro de status para "Todos"
    let lastTerm = '';

    function setStatusFilter(filter) {
        statusFilter = filter;
        statusChips.forEach(c => c.classList.toggle('is-active', c.dataset.filter === filter));
    }

    searchInput.addEventListener('input', () => {
        const term = searchInput.value.trim();

        if (term && !lastTerm && statusFilter !== 'all')
            setStatusFilter('all');

        lastTerm = term;
        applyFilters();
    });
    updateCount(rows.length);

    // ── Reactivate modal ──────────────────────────────────────────────
    const reactivateModal = document.getElementById('reactivateModal');
    const reactivateEmailEl = document.getElementById('reactivateEmail');
    const reactivateIdField = document.getElementById('reactivateId');
    const reactivateDays = document.getElementById('reactivateDays');
    const reactivateDaysField = document.getElementById('reactivateDaysField');
    const reactivatePresets = document.querySelectorAll('#reactivatePresets .preset-btn');

    function syncReactivatePresets() {
        reactivatePresets.forEach(b =>
            b.classList.toggle('is-active', b.dataset.days === reactivateDays.value));
    }

    reactivatePresets.forEach(btn => {
        btn.addEventListener('click', () => {
            reactivateDays.value = btn.dataset.days;
            syncReactivatePresets();
        });
    });

    reactivateDays.addEventListener('input', () => {
        reactivatePresets.forEach(b => b.classList.remove('is-active'));
    });

    document.getElementById('reactivateMinus').addEventListener('click', () => {
        if (parseInt(reactivateDays.value) > 1) reactivateDays.stepDown();
        syncReactivatePresets();
    });

    document.getElementById('reactivatePlus').addEventListener('click', () => {
        if (parseInt(reactivateDays.value) < 365) reactivateDays.stepUp();
        syncReactivatePresets();
    });

    // Nome/sobrenome editáveis na reativação (o SASE recusa acentos)
    const reactivateName = document.getElementById('reactivateName');
    const reactivateLastName = document.getElementById('reactivateLastName');
    const reactivateNameError = document.getElementById('reactivateNameError');
    const nomeValidoRegex = /^[a-z '-]+$/i;

    const removerAcentos = txt => txt.normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    function validarNomeReativacao() {
        const nome = reactivateName.value.trim();
        const sobrenome = reactivateLastName.value.trim();
        let erro = null;

        if (!nome)
            erro = 'Informe o nome.';
        else if (!nomeValidoRegex.test(nome) || (sobrenome && !nomeValidoRegex.test(sobrenome)))
            erro = 'Use apenas letras sem acento, espaços, apóstrofos ou hífens. Clique em "Remover acentos".';

        reactivateNameError.textContent = erro || '';
        reactivateNameError.classList.toggle('hidden', !erro);
        [reactivateName, reactivateLastName].forEach(i => i.classList.toggle('is-invalid', !!erro));
        return !erro;
    }

    document.getElementById('reactivateStripAccents').addEventListener('click', () => {
        reactivateName.value = removerAcentos(reactivateName.value);
        reactivateLastName.value = removerAcentos(reactivateLastName.value);
        validarNomeReativacao();
    });

    [reactivateName, reactivateLastName].forEach(i => i.addEventListener('input', validarNomeReativacao));

    document.querySelectorAll('.reactivate-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            reactivateEmailEl.textContent = btn.dataset.email;
            reactivateIdField.value = btn.dataset.id;
            reactivateName.value = btn.dataset.name || '';
            reactivateLastName.value = btn.dataset.lastname || '';
            reactivateDays.value = '30';
            syncReactivatePresets();
            validarNomeReativacao();
            reactivateModal.classList.remove('hidden');
        });
    });

    document.getElementById('cancelReactivateBtn').addEventListener('click', () => {
        reactivateModal.classList.add('hidden');
    });

    document.getElementById('confirmReactivateBtn').addEventListener('click', () => {
        if (!validarNomeReativacao()) {
            reactivateName.focus();
            return;
        }

        reactivateDaysField.value = reactivateDays.value;
        document.getElementById('reactivateNameField').value = reactivateName.value.trim();
        document.getElementById('reactivateLastNameField').value = reactivateLastName.value.trim();
        showLoading("Reativando usuário...");
        document.getElementById('reactivateForm').submit();
    });

    // ── Logs modal ───────────────────────────────────────────────────
    const logsModal = document.getElementById('logsModal');
    const logsContainer = document.getElementById('logsContainer');
    const logsSearch = document.getElementById('logsSearch');
    let allLogs = [];

    function levelClass(level) {
        switch (level) {
            case 'Warning': return 'log-warn';
            case 'Error': return 'log-error';
            case 'Critical': return 'log-error';
            default: return 'log-info';
        }
    }

    function renderLogs(filter = '') {
        const term = filter.toLowerCase();
        const filtered = term
            ? allLogs.filter(l => l.message.toLowerCase().includes(term)
                || l.category.toLowerCase().includes(term)
                || l.level.toLowerCase().includes(term))
            : allLogs;

        while (logsContainer.firstChild)
            logsContainer.removeChild(logsContainer.firstChild);

        if (filtered.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'empty-text';
            empty.textContent = 'Nenhum log encontrado.';
            logsContainer.appendChild(empty);
            return;
        }

        filtered.forEach(l => {
            const line = document.createElement('div');
            line.className = 'log-line ' + levelClass(l.level);

            const time = document.createElement('span');
            time.className = 'log-time';
            time.textContent = l.time;

            const level = document.createElement('span');
            level.className = 'log-level';
            level.textContent = l.level;

            const cat = document.createElement('span');
            cat.className = 'log-cat';
            cat.textContent = l.category;

            const msg = document.createElement('span');
            msg.className = 'log-msg';
            msg.textContent = l.message;

            line.appendChild(time);
            line.appendChild(level);
            line.appendChild(cat);
            line.appendChild(msg);

            logsContainer.appendChild(line);
        });
    }

    async function loadLogs() {
        while (logsContainer.firstChild)
            logsContainer.removeChild(logsContainer.firstChild);
        const loading = document.createElement('div');
        loading.className = 'loading-text';
        loading.textContent = 'Carregando...';
        logsContainer.appendChild(loading);

        try {
            const res = await fetch('/api/logs');
            allLogs = await res.json();
            renderLogs(logsSearch.value);
        } catch {
            while (logsContainer.firstChild)
                logsContainer.removeChild(logsContainer.firstChild);
            const err = document.createElement('div');
            err.className = 'empty-text';
            err.textContent = 'Erro ao carregar logs.';
            logsContainer.appendChild(err);
        }
    }

    document.getElementById('logsBtn').addEventListener('click', () => {
        logsModal.classList.remove('hidden');
        loadLogs();
    });

    document.getElementById('closeLogsBtn').addEventListener('click', () => {
        logsModal.classList.add('hidden');
    });

    document.getElementById('refreshLogsBtn').addEventListener('click', loadLogs);

    logsSearch.addEventListener('input', () => renderLogs(logsSearch.value));

    // ── Tooltip de grupos: um só elemento, montado ao passar o mouse ──
    const groupsTooltip = document.getElementById('groupsTooltip');
    const gridBody = document.querySelector('tbody');
    const gridScroll = document.querySelector('.table-scroll');

    function buildGroupsTooltip(names) {
        while (groupsTooltip.firstChild) groupsTooltip.removeChild(groupsTooltip.firstChild);

        const title = document.createElement('div');
        title.className = 'tooltip-title';
        title.textContent = 'Grupos de acesso';
        groupsTooltip.appendChild(title);

        const addItem = (text, locked) => {
            const item = document.createElement('div');
            item.className = 'tooltip-group' + (locked ? ' is-locked' : '');
            const dot = document.createElement('span');
            dot.className = 'tooltip-dot' + (locked ? ' locked' : '');
            item.appendChild(dot);
            item.appendChild(document.createTextNode(text));
            if (locked) {
                const tag = document.createElement('span');
                tag.className = 'tooltip-lock-tag';
                tag.textContent = 'padrão';
                item.appendChild(tag);
            }
            groupsTooltip.appendChild(item);
        };

        addItem('All Users', true);
        names.forEach(n => addItem(n, false));
    }

    gridBody.addEventListener('mouseover', e => {
        const trigger = e.target.closest('.groups-trigger');
        if (!trigger || trigger.contains(e.relatedTarget)) return;

        const names = (trigger.dataset.groups || '').split('|').filter(Boolean);
        buildGroupsTooltip(names);
        groupsTooltip.classList.add('is-visible');

        const r = trigger.getBoundingClientRect();
        const tipH = groupsTooltip.offsetHeight;
        const tipW = groupsTooltip.offsetWidth;
        const above = r.top - tipH - 8;

        groupsTooltip.style.top = (above > 8 ? above : r.bottom + 8) + 'px';
        groupsTooltip.style.left = Math.min(
            Math.max(8, r.left + r.width / 2 - tipW / 2),
            window.innerWidth - tipW - 8) + 'px';
    });

    gridBody.addEventListener('mouseout', e => {
        const trigger = e.target.closest('.groups-trigger');
        if (!trigger || trigger.contains(e.relatedTarget)) return;
        groupsTooltip.classList.remove('is-visible');
    });

    gridScroll.addEventListener('scroll', () => groupsTooltip.classList.remove('is-visible'), { passive: true });

    // ── Sort ──────────────────────────────────────────────────────────
    const tbody = document.querySelector('tbody');
    const sortHeaders = document.querySelectorAll('.th-sortable');
    let currentSort = 'criado';
    let currentAsc = false;

    function sortTable(field, asc) {
        const rowsArray = Array.from(tbody.querySelectorAll('tr'));

        rowsArray.sort((a, b) => {
            const statusA = a.classList.contains('row-removed') ? 1 : 0;
            const statusB = b.classList.contains('row-removed') ? 1 : 0;
            if (statusA !== statusB) return statusA - statusB;

            let valA, valB;
            if (field === 'criado') {
                valA = parseInt(a.querySelector('.cell-date')?.dataset.timestamp || '0');
                valB = parseInt(b.querySelector('.cell-date')?.dataset.timestamp || '0');
            } else {
                valA = parseInt(a.querySelector('[data-expire]')?.dataset.expire || '0');
                valB = parseInt(b.querySelector('[data-expire]')?.dataset.expire || '0');
            }

            return asc ? valA - valB : valB - valA;
        });

        rowsArray.forEach(row => tbody.appendChild(row));
    }

    sortHeaders.forEach(th => {
        th.addEventListener('click', () => {
            const field = th.dataset.sort;

            if (currentSort === field) {
                currentAsc = !currentAsc;
            } else {
                currentSort = field;
                currentAsc = false;
            }

            sortHeaders.forEach(h => h.classList.remove('is-active', 'asc'));
            th.classList.add('is-active');
            if (currentAsc) th.classList.add('asc');

            sortTable(currentSort, currentAsc);
        });
    });

</script>
