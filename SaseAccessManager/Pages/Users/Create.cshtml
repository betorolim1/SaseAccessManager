@page
@model SaseAccessManager.Pages.Users.CreateModel

<link rel="stylesheet" href="~/css/users/create.css" asp-append-version="true">

    @if (TempData["ToastMessage"] != null)
    {
        <div id="toast" class="toast @(TempData["ToastType"])">
            @(TempData["ToastType"]?.ToString() == "success" ? "✓" : "✕")
            @TempData["ToastMessage"]
        </div>
    }

@functions {
    string UserInitials(string name) => string.IsNullOrWhiteSpace(name) ? "?" :
        name.Split(' ').Take(2).Aggregate("", (a, w) => a + (w.Length > 0 ? w[0].ToString().ToUpper() : ""));

    string GroupName(string groupId) =>
        Model.AvailableGroups.FirstOrDefault(g => g.Id == groupId)?.Name ?? groupId;
}

<!-- TOP BAR -->
<div class="topbar">
    <div class="topbar-brand">
        <div class="brand-icon">🛡</div>
        <div>
            <div class="brand-title">Harmony SASE</div>
            <div class="brand-sub">Access Manager</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="session-pill">
            <div class="avatar">@UserInitials(User.Identity?.Name ?? "")</div>
            <strong>@User.Identity?.Name</strong>
        </div>

        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="logout-btn">Sair</button>
        </form>
    </div>
</div>

<!-- MAIN -->
<div class="main">

    <!-- BREADCRUMB -->
    <nav class="breadcrumb">
        <a href="/Users">Usuários</a>
        <span class="breadcrumb-sep">›</span>
        <span class="breadcrumb-current">@(Model.IsEdit ? "Editar grupos" : "Novo usuário")</span>
    </nav>

    <div class="page-title">@(Model.IsEdit ? "Editar grupos de acesso" : "Novo usuário temporário")</div>
    <div class="page-subtitle">
        @(Model.IsEdit
                ? "Modifique os grupos de acesso do usuário no Harmony SASE."
                : "Preencha os dados para criar um novo acesso remoto temporário.")
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-error">⚠ @Model.Message</div>
    }

    <form method="post" id="mainForm">
        <input type="hidden" asp-for="IsEdit" value="@Model.IsEdit" />
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="ForceImport" id="forceImportField" value="false" />
        <input type="hidden" asp-for="SaseUserIdForImport" value="@Model.SaseUserIdForImport" />
        <input type="hidden" id="importDaysField" name="ImportDurationDays" value="@Model.DurationDays" />
        @if (!Model.IsEdit)
        {
            <input type="hidden" id="Email" name="Email" value="@Model.Email" />
            <input type="hidden" id="Name" name="Name" value="@Model.Name" />
            <input type="hidden" id="LastName" name="LastName" value="@Model.LastName" />
        }
        @foreach (var gId in Model.ExistingSaseGroupIds)
        {
            <input type="hidden" name="ExistingSaseGroupIds" value="@gId" />
        }

        <div class="form-card">

            @if (Model.IsEdit)
            {
                <div class="card-section">
                    <div class="section-label">Dados do usuário</div>
                    <div class="form-grid">
                        <div class="form-group span-2">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-input" readonly="true" />
                            <span asp-validation-for="Email" class="validation"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-input" readonly="true" />
                            <span asp-validation-for="Name" class="validation"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-input" readonly="true" />
                            <span asp-validation-for="LastName" class="validation"></span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card-section">
                    <div class="section-label">Dados do usuário</div>
                    <div id="batchRows"></div>
                    <button type="button" class="btn-add-row" id="addRowBtn">+ Adicionar usuário</button>
                </div>
            }

            <!-- SECTION: Duração do acesso -->
            <div class="card-section">
                <div class="section-label">Duração do acesso</div>

                <div class="duration-presets">
                    <button type="button" class="preset-btn" data-days="30">30 dias</button>
                    <button type="button" class="preset-btn" data-days="90">90 dias</button>
                    <button type="button" class="preset-btn" data-days="180">180 dias</button>
                    <button type="button" class="preset-btn" data-days="365">365 dias</button>
                </div>

                <div class="form-group max-200">
                    <label asp-for="DurationDays" class="form-label">Ou defina manualmente</label>
                    <div class="number-input">
                        <button type="button" class="num-btn minus">−</button>
                        <input asp-for="DurationDays"
                               type="number"
                               class="form-input"
                               min="1"
                               max="365"
                               step="1"
                               placeholder="30" />
                        <button type="button" class="num-btn plus">+</button>
                    </div>
                    <span asp-validation-for="DurationDays" class="validation"></span>
                </div>
            </div>

            <!-- SECTION: Grupos de acesso -->
            <div class="card-section">
                <div class="section-label">Grupos de acesso</div>
                <div class="groups-list">

                    <!-- All Users — sempre incluído, bloqueado -->
                    <label class="group-item is-locked is-checked">
                        <div class="check-box">
                            <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                                <path d="M1 4L3.5 6.5L9 1" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <span class="group-name">All Users</span>
                        <span class="group-locked-tag">sempre incluído</span>
                        <input type="checkbox" checked disabled />
                    </label>

                    @foreach (var g in Model.AvailableGroups)
                    {
                        var isChecked = Model.SelectedGroups.Contains(g.Id);
                        <label class="group-item @(isChecked ? "is-checked" : "")"
                               data-group-id="@g.Id">
                            <div class="check-box">
                                <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                                    <path d="M1 4L3.5 6.5L9 1" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>
                            <span class="group-name">@g.Name</span>
                            <input class="group-checkbox"
                                   type="checkbox"
                                   name="SelectedGroups"
                                   value="@g.Id"
                            @(isChecked ? "checked" : "") />
                        </label>
                    }

                </div>
            </div>

            <!-- ACTIONS -->
            <div class="form-actions">
                <a href="/Users" class="btn btn-ghost">Cancelar</a>
                <button id="submitBtn"
                        type="submit"
                        class="btn btn-primary"
                        disabled="@(Model.IsEdit)">
                    @(Model.IsEdit ? "Salvar alterações" : "Criar usuário")
                </button>
            </div>

        </div>
    </form>
</div>

<!-- BATCH FORM -->
<form id="batchForm" method="post" asp-page-handler="Batch" class="hidden">
    <div id="batchHiddenFields"></div>
    <input type="hidden" name="DurationDays" id="batchDurationDays" value="30" />
</form>

<!-- IMPORT MODAL -->
<div id="importModal" class="modal-overlay hidden">
    <div class="modal-box">
        <div class="modal-icon">⚠️</div>
        <div class="modal-title">Usuário já existe no SASE</div>
        <div class="modal-body">
            Este usuário já possui uma conta ativa no Harmony SASE.<br>
            Deseja importá-lo para o gerenciamento do sistema?<br><br>
            Ele será cadastrado no banco de dados e terá seu <strong>tempo de vida controlado por aqui</strong>, sendo removido automaticamente ao expirar.<br><br>
            <span class="modal-warning">⚠ Os grupos selecionados no formulário serão ignorados. O usuário será importado apenas com os grupos que já possui no SASE. Para adicionar ou remover grupos, edite o usuário após a importação.</span>

            @if (Model.ExistingSaseGroupIds.Any())
            {
                <div class="modal-groups">
                    <div class="modal-groups-label">Grupos atuais no SASE:</div>
                    <div class="modal-groups-list">
                        <span class="modal-group-chip modal-group-chip--default">All Users</span>
                        @foreach (var gId in Model.ExistingSaseGroupIds)
                        {
                            <span class="modal-group-chip">@GroupName(gId)</span>
                        }
                    </div>
                </div>
            }

            <div class="modal-duration">
                <div class="modal-groups-label">Duração do acesso</div>
                <div class="duration-presets" id="importPresets">
                    <button type="button" class="preset-btn" data-days="30">30 dias</button>
                    <button type="button" class="preset-btn" data-days="90">90 dias</button>
                    <button type="button" class="preset-btn" data-days="180">180 dias</button>
                    <button type="button" class="preset-btn" data-days="365">365 dias</button>
                </div>
                <div class="number-input-wrap">
                    <div class="number-input">
                        <button type="button" class="num-btn minus" id="importMinus">−</button>
                        <input type="number"
                               id="importDays"
                               class="form-input"
                               min="1"
                               max="365"
                               value="30"
                               step="1" />
                        <button type="button" class="num-btn plus" id="importPlus">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-actions">
            <a href="/Users" class="btn btn-ghost">Cancelar</a>
            <button type="button" id="confirmImportBtn" class="btn btn-primary">
                Importar usuário
            </button>
        </div>
    </div>
</div>


<footer class="footer">
    <span>Desenvolvido pela CGSIC — Coordenação-Geral de Segurança da Informação e Cibersegurança</span>
</footer>

<div id="loadingOverlay" class="loading-overlay hidden">
    <div class="loader"></div>
    <div class="loading-text">Processando...</div>
</div>

<script nonce="@HttpContext.Items["CSP-Nonce"]">

     // ── Utilitários (declarar ANTES de usar) ──────────────────────────
     function showLoading(text = "Processando...") {
         const overlay = document.getElementById("loadingOverlay");
         overlay.querySelector(".loading-text").innerText = text;
         overlay.classList.remove("hidden");
     }

     function hideLoading() {
         document.getElementById("loadingOverlay").classList.add("hidden");
     }

     // ── Estado global ─────────────────────────────────────────────────
     const isEdit = '@Model.IsEdit'.toLowerCase() === 'true';
     const durationInput = document.getElementById('DurationDays');
     const presetBtns = document.querySelectorAll('.preset-btn');

     // ── Presets ───────────────────────────────────────────────────────
     function syncPresets() {
         const val = durationInput.value;
         presetBtns.forEach(b => {
             b.classList.toggle('is-active', b.dataset.days === val);
         });
     }
    
     function clearPresets() {
         presetBtns.forEach(b => b.classList.remove('is-active'));
     }

     // ── checkChanges (precisa existir antes dos listeners) ────────────
     let checkChanges = () => {};

     if (isEdit) {
         const checkboxes     = document.querySelectorAll('.group-checkbox');
         const submitBtn      = document.getElementById('submitBtn');
         const originalGroups = Array.from(checkboxes).map(cb => cb.checked);
         const originalDays   = durationInput.value;

         checkChanges = function () {
             const groupsChanged   = Array.from(checkboxes).some((cb, i) => cb.checked !== originalGroups[i]);
             const durationChanged = durationInput.value !== originalDays;
             submitBtn.disabled = !(groupsChanged || durationChanged);
         };

         checkboxes.forEach(cb => cb.addEventListener('change', checkChanges));
         durationInput.addEventListener('input', checkChanges);
         document.querySelectorAll('.num-btn').forEach(btn => {
             btn.addEventListener('click', () => setTimeout(syncPresets, 10));
         });
         document.querySelectorAll('.preset-btn').forEach(btn => {
             btn.addEventListener('click', () => setTimeout(checkChanges, 10));
         });
     }

     // ── Listeners ─────────────────────────────────────────────────────
     presetBtns.forEach(btn => {
         btn.addEventListener('click', () => {
             durationInput.value = btn.dataset.days;
             presetBtns.forEach(b => b.classList.remove('is-active'));
             btn.classList.add('is-active');
             checkChanges();
         });
     });

     durationInput.addEventListener('input', syncPresets);

     document.querySelectorAll('.num-btn').forEach(btn => {
         btn.addEventListener('click', () => setTimeout(clearPresets, 10));
     });

     document.querySelectorAll('.number-input').forEach(wrapper => {
         const input = wrapper.querySelector('input');
         wrapper.querySelector('.plus').addEventListener('click', () => {
             input.stepUp();
             if (input.id === 'importDays') syncImportPresets();
             else syncPresets();
         });
         wrapper.querySelector('.minus').addEventListener('click', () => {
             input.stepDown();
             if (input.id === 'importDays') syncImportPresets();
             else syncPresets();
         });
     });

     document.querySelectorAll('.group-item:not(.is-locked)').forEach(item => {
         item.addEventListener('click', () => {
             const cb = item.querySelector('input[type="checkbox"]');
             cb.checked = !cb.checked;
             item.classList.toggle('is-checked', cb.checked);
             checkChanges();
         });
     });

     document.querySelectorAll("form").forEach(form => {
         form.addEventListener("submit", () => {
             showLoading("Processando...");
             document.body.classList.add("loading");
         });
     });

     setTimeout(() => {
         const t = document.getElementById("toast");
         if (t) { t.classList.add("toast-hide"); setTimeout(() => t.remove(), 400); }
     }, 4000);

     // ── Init ──────────────────────────────────────────────────────────
     showLoading("Carregando grupos...");

     window.addEventListener("load", () => {
         hideLoading();
     });

         // ── Import modal ──────────────────────────────────────────────
     const showImportModal  = '@Model.ShowImportModal'.toLowerCase() === 'true';
     const importModal      = document.getElementById('importModal');
     const confirmImportBtn = document.getElementById('confirmImportBtn');
     const forceImportField = document.getElementById('forceImportField');
     const importDays       = document.getElementById('importDays');
     const importDaysField  = document.getElementById('importDaysField');
     const importPresets    = document.querySelectorAll('#importPresets .preset-btn');

     function syncImportPresets() {
         importPresets.forEach(b =>
             b.classList.toggle('is-active', b.dataset.days === importDays.value));
     }

     importPresets.forEach(btn => {
         btn.addEventListener('click', () => {
             importDays.value = btn.dataset.days;
             syncImportPresets();
         });
     });

     importDays.addEventListener('input', syncImportPresets);

     if (showImportModal) {
         importModal.classList.remove('hidden');
         syncImportPresets();
     }

     confirmImportBtn.addEventListener('click', () => {
         forceImportField.value = 'true';
         durationInput.value  = importDays.value;
         showLoading("Importando usuário...");
         document.getElementById('mainForm').submit();
     });



     // ── Batch rows ────────────────────────────────────────────────
     function addBatchRow() {
         const container = document.getElementById('batchRows');

         const row = document.createElement('div');
         row.className = 'batch-row';

         // Grid
         const grid = document.createElement('div');
         grid.className = 'batch-row-grid';

         // Email
         const emailGroup = document.createElement('div');
         emailGroup.className = 'form-group span-2';
         const emailLabel = document.createElement('label');
         emailLabel.className = 'form-label';
         emailLabel.textContent = 'Email';
         const emailInput = document.createElement('input');
         emailInput.type = 'email';
         emailInput.className = 'form-input batch-email';
         emailInput.placeholder = 'usuario@empresa.com';
         emailGroup.appendChild(emailLabel);
         emailGroup.appendChild(emailInput);

         // Nome
         const nameGroup = document.createElement('div');
         nameGroup.className = 'form-group';
         const nameLabel = document.createElement('label');
         nameLabel.className = 'form-label';
         nameLabel.textContent = 'Nome';
         const nameInput = document.createElement('input');
         nameInput.type = 'text';
         nameInput.className = 'form-input batch-name';
         nameInput.placeholder = 'Nome';
         nameGroup.appendChild(nameLabel);
         nameGroup.appendChild(nameInput);

         // Sobrenome
         const lastNameGroup = document.createElement('div');
         lastNameGroup.className = 'form-group';
         const lastNameLabel = document.createElement('label');
         lastNameLabel.className = 'form-label';
         lastNameLabel.textContent = 'Sobrenome';
         const lastNameInput = document.createElement('input');
         lastNameInput.type = 'text';
         lastNameInput.className = 'form-input batch-lastname';
         lastNameInput.placeholder = 'Sobrenome';
         lastNameGroup.appendChild(lastNameLabel);
         lastNameGroup.appendChild(lastNameInput);

         grid.appendChild(emailGroup);
         grid.appendChild(nameGroup);
         grid.appendChild(lastNameGroup);

         // Botão remover
         const removeBtn = document.createElement('button');
         removeBtn.type = 'button';
         removeBtn.className = 'btn-remove-row';
         removeBtn.title = 'Remover';
         removeBtn.textContent = '×';
         removeBtn.addEventListener('click', () => {
             row.remove();
             updateRemoveButtons();
         });

         row.appendChild(grid);
         row.appendChild(removeBtn);

         container.appendChild(row);
         updateRemoveButtons();
     }

     function updateRemoveButtons() {
         const rows = document.querySelectorAll('.batch-row');
         rows.forEach(r => {
             r.querySelector('.btn-remove-row').style.display = rows.length > 1 ? '' : 'none';
         });
     }

     // ── Batch submit ──────────────────────────────────────────────
     if (!isEdit) {
         const batchSubmitBtn = document.createElement('button');
         batchSubmitBtn.type = 'button';
         batchSubmitBtn.className = 'btn btn-primary';
         batchSubmitBtn.textContent = 'Criar usuário(s)';
         batchSubmitBtn.id = 'batchSubmitBtn';
         document.querySelector('.form-actions').appendChild(batchSubmitBtn);

         document.getElementById('submitBtn').style.display = 'none';

         addBatchRow();

         document.getElementById('addRowBtn')?.addEventListener('click', addBatchRow);

         batchSubmitBtn.addEventListener('click', () => {
         const hiddenContainer = document.getElementById('batchHiddenFields');
         while (hiddenContainer.firstChild) hiddenContainer.removeChild(hiddenContainer.firstChild);

         const rows = document.querySelectorAll('.batch-row');
         const nameRegex = /^[a-z '-]+$/i;
         let hasAny = false;
         let validationError = null;

         const addHidden = (fieldName, value) => {
             const input = document.createElement('input');
             input.type = 'hidden';
             input.name = fieldName;
             input.value = value;
             hiddenContainer.appendChild(input);
         };

         rows.forEach(row => {
             if (validationError) return;

             const email    = row.querySelector('.batch-email').value.trim();
             const name     = row.querySelector('.batch-name').value.trim();
             const lastName = row.querySelector('.batch-lastname').value.trim();

             if (!email) return;

             if (name && !nameRegex.test(name)) {
                 validationError = `Nome inválido: "${name}". Use apenas letras, espaços, apóstrofos ou hífens.`;
                 return;
             }

             if (lastName && !nameRegex.test(lastName)) {
                 validationError = `Sobrenome inválido: "${lastName}". Use apenas letras, espaços, apóstrofos ou hífens.`;
                 return;
             }

             hasAny = true;
             addHidden('BatchEmails', email);
             addHidden('BatchNames', name);
             addHidden('BatchLastNames', lastName);
         });

         if (validationError) {
             alert(validationError);
             return;
         }

         if (!hasAny) {
             alert('Informe ao menos um e-mail.');
             return;
         }

         document.querySelectorAll('.group-checkbox:checked').forEach(cb => {
             addHidden('SelectedGroups', cb.value);
         });

            document.getElementById('batchDurationDays').value = durationInput.value;

            const validRows = Array.from(rows).filter(r =>
                r.querySelector('.batch-email').value.trim() !== ''
            );

            if (validRows.length === 1) {
                const r = validRows[0];
                document.getElementById('Email').value    = r.querySelector('.batch-email').value.trim();
                document.getElementById('Name').value     = r.querySelector('.batch-name').value.trim();
                document.getElementById('LastName').value = r.querySelector('.batch-lastname').value.trim();
                showLoading("Criando usuário...");
                document.getElementById('mainForm').submit();
            } else {
                showLoading("Criando usuários...");
                document.getElementById('batchForm').submit();
            }
     });
    }
</script>